  "dependencies": [
    {
      "name": "qtbase",
      "default-features": false,
      "features": ["doubleconversion", "widgets", "concurrent"]
    },
    {
      "name": "sail",
      "features": [
        "highest-priority-codecs",
        "high-priority-codecs",
        "low-priority-codecs",
        "heif",
        "psd",
        "raw",
        "tiff"
      ]
    }
  ]
}
